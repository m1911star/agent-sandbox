#!/usr/bin/env bash
set -euo pipefail

_self="${BASH_SOURCE[0]}"
while [[ -L "$_self" ]]; do
    _dir="$(CDPATH= cd -- "$(dirname "$_self")" && pwd)"
    _self="$(readlink "$_self")"
    [[ "$_self" != /* ]] && _self="$_dir/$_self"
done
SANDBOX_ROOT="$(CDPATH= cd -- "$(dirname "$_self")" && pwd)"
unset _self _dir

source "${SANDBOX_ROOT}/lib/common.sh"

VERSION="0.2.0"
DEFAULT_GATEWAY_URL=http://127.0.0.1:3425/v1

usage() {
    cat <<HELP
agent-sandbox v${VERSION}
Run a clean coding agent in Docker with your Magpie gateway.

Usage:
  sandbox up    <agent> [workspace] [--no-proxy]
  sandbox down  <agent> [--purge]
  sandbox list
  sandbox status [agent]

Agents:
  omp          OMP (Oh My Pi), command: omp
  claude-code  Claude Code, command: claude
  codex        Codex, command: codex

Examples:
  sandbox up omp ~/my-project       # launch OMP with a project
  sandbox up claude-code             # launch Claude Code
  sandbox up codex --no-proxy        # launch without proxy forwarding
  sandbox down omp --purge           # remove container + image
  sandbox list                       # show all agents & status

Environment:
  OPENAI_API_KEY       Required Magpie gateway key (export on the host)
  OPENAI_BASE_URL      Magpie API URL (default: ${DEFAULT_GATEWAY_URL})
  MAGPIE_MODEL         Model ID override (defaults depend on the agent)
  NPM_CONFIG_REGISTRY  Optional package registry URL for an image build
  PROXY_PORT           Optional host HTTP proxy port (direct by default)
HELP
}

AGENTS_DIR="${SANDBOX_ROOT}/agents"

list_agent_names() {
    local d
    for d in "${AGENTS_DIR}"/*/; do
        [[ -f "${d}agent.sh" ]] && basename "$d"
    done
}

load_agent() {
    local name="$1"
    AGENT_DIR="${AGENTS_DIR}/${name}"
    if [[ ! "$name" =~ ^[a-z][a-z0-9-]*$ || ! -f "$AGENT_DIR/agent.sh" ]]; then
        error "Unknown agent: $name. Choose from: $(list_agent_names | paste -sd ' ' -)."
    fi
    source "$AGENT_DIR/agent.sh"
}

cmd_up() {
    local agent="" workspace="" skip_proxy=false
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --no-proxy) skip_proxy=true ;;
            -*)  error "Unknown option: $1" ;;
            *)
                if [[ -z "$agent" ]]; then agent="$1"
                elif [[ -z "$workspace" ]]; then workspace="$1"
                else error "Unexpected argument: $1"
                fi ;;
        esac
        shift
    done
    [[ -n "$agent" ]] || error "Usage: sandbox up <agent> [workspace] [--no-proxy]"

    load_agent "$agent"
    local model="${MAGPIE_MODEL:-$AGENT_MODEL}" proxy_port="${PROXY_PORT:-}" magpie_key="${OPENAI_API_KEY:-}"
    [[ -n "$magpie_key" ]] || error "Export OPENAI_API_KEY with your Magpie gateway key."
    unset OPENAI_API_KEY MAGPIE_API_KEY
    if [[ -n "${NPM_CONFIG_REGISTRY:-}" ]]; then
        parse_http_url "$NPM_CONFIG_REGISTRY" \
            || error "Set NPM_CONFIG_REGISTRY to an HTTP(S) URL with a host and optional port and path, without credentials, query, or fragment."
    fi
    parse_gateway_url "${OPENAI_BASE_URL-$DEFAULT_GATEWAY_URL}" \
        || error "Set OPENAI_BASE_URL to an HTTP(S) URL with a host and optional port and path, without credentials, query, or fragment."
    [[ "$model" =~ ^[a-zA-Z0-9][a-zA-Z0-9._:/-]*$ ]] || error "Set MAGPIE_MODEL to a Magpie model ID."
    [[ "$skip_proxy" == false ]] || proxy_port=""
    [[ -z "$proxy_port" ]] || valid_port "$proxy_port" || error "Set PROXY_PORT to a port from 1 to 65535."
    if [[ -n "$workspace" ]]; then
        workspace="$(CDPATH= cd -- "$workspace" 2>/dev/null && pwd -P)" || error "Workspace directory is not accessible."
        [[ "$workspace" != *:* ]] || error "Workspace path cannot contain a colon."
    fi

    require_docker
    if container_exists "$AGENT_CONTAINER" -a; then
        error "$AGENT_CONTAINER already exists. Resume with 'docker start -ai $AGENT_CONTAINER' if stopped, or explicitly remove it with 'sandbox down $agent' before creating a new sandbox."
    fi

    header "$AGENT_DISPLAY_NAME Sandbox"
    SANDBOX_ARGS=(--name "$AGENT_CONTAINER" --network bridge -e MAGPIE_API_KEY -e "OPENAI_BASE_URL=$GATEWAY_URL" -e "MAGPIE_MODEL=$model")
    if [[ -f "$AGENT_DIR/seccomp.json" ]]; then
        SANDBOX_ARGS+=(--security-opt "seccomp=$AGENT_DIR/seccomp.json")
    fi
    network_args "$proxy_port"
    if [[ -n "$workspace" ]]; then
        SANDBOX_ARGS+=(-v "${workspace}:/workspace:rw")
        info "Workspace: $workspace (read-write at /workspace)"
    fi
    build_image_if_needed

    printf '  Agent:   %s\n  Model:   %s\n  Gateway: %s\n' "$AGENT_COMMAND" "$model" "$GATEWAY_URL"
    echo "  Exit:    type 'exit'"
    echo "  Resume:  docker start -ai ${AGENT_CONTAINER}"
    echo ""

    local rc=0
    MAGPIE_API_KEY="$magpie_key" docker run -it "${SANDBOX_ARGS[@]}" "$AGENT_IMAGE" || rc=$?

    if container_exists "$AGENT_CONTAINER" -a; then
        echo ""
        info "Sandbox exited. Container preserved as '${AGENT_CONTAINER}'."
        echo "  Resume:  docker start -ai ${AGENT_CONTAINER}"
        echo "  Delete:  sandbox down ${agent} [--purge]"
    fi
    return "$rc"
}

cmd_down() {
    local agent="" purge=false
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --purge) purge=true ;;
            -*)  error "Unknown option: $1" ;;
            *)   [[ -z "$agent" ]] && agent="$1" || error "Unexpected argument: $1" ;;
        esac
        shift
    done
    [[ -n "$agent" ]] || error "Usage: sandbox down <agent> [--purge]"

    load_agent "$agent"
    require_docker

    header "Tearing Down $AGENT_DISPLAY_NAME"
    remove_container "$AGENT_CONTAINER"

    if [[ "$purge" == true ]]; then
        remove_image "$AGENT_IMAGE"
    else
        info "Image kept: $AGENT_IMAGE (pass --purge to remove)"
    fi

    echo ""
    info "Done. Host configuration was never touched."
}

cmd_list() {
    [[ $# -eq 0 ]] || error "Usage: sandbox list"
    require_docker
    header "Agents"
    printf "  %-14s %-12s %s\n" "NAME" "STATUS" "CONTAINER"
    echo "  ──────────────────────────────────────────"

    local name containers
    containers=$(docker ps -a --format '{{.Names}}\t{{.State}}') || error "Could not list Docker containers."
    for name in $(list_agent_names); do
        (
            load_agent "$name"
            local st="—" container state
            while IFS=$'\t' read -r container state; do
                [[ "$container" == "$AGENT_CONTAINER" ]] || continue
                st=stopped
                [[ "$state" != running ]] || st=running
                break
            done <<< "$containers"
            printf "  %-14s %-12s %s\n" "$name" "$st" "$AGENT_CONTAINER"
        )
    done
}

cmd_status() {
    [[ $# -le 1 ]] || error "Usage: sandbox status [agent]"
    [[ $# -ne 0 ]] || { cmd_list; return; }
    local agent="$1"
    [[ "$agent" != -* ]] || error "Unknown option: $agent"

    load_agent "$agent"
    require_docker

    if container_exists "$AGENT_CONTAINER" -a; then
        docker ps -a --filter "name=^${AGENT_CONTAINER}$" \
            --format "table {{.Names}}\t{{.Status}}\t{{.Image}}\t{{.Size}}"
    else
        warn "No container found: $AGENT_CONTAINER"
    fi
}

[[ $# -eq 0 ]] && { usage; exit 0; }

case "$1" in
    up)       shift; cmd_up "$@" ;;
    down)     shift; cmd_down "$@" ;;
    list|ls)  shift; cmd_list "$@" ;;
    status)   shift; cmd_status "$@" ;;
    -h|--help|help) usage ;;
    -v|--version)   echo "agent-sandbox v${VERSION}" ;;
    *)        error $'Unknown command: '"$1"$'\n       Run \'sandbox help\' for usage.' ;;
esac
